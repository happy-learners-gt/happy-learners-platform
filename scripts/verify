#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
required=(
  "apps/web/README.md"
  "apps/api/README.md"
  "packages/domain/README.md"
  "packages/contracts/README.md"
  "database/migrations/README.md"
  "infrastructure/README.md"
  "tests/README.md"
)

for relative in "${required[@]}"; do
  if [[ ! -f "$repo_root/$relative" ]]; then
    echo "Falta un límite del monorepo: $relative" >&2
    exit 1
  fi
done

cd "$repo_root"
export WRANGLER_SEND_METRICS=false
export WRANGLER_LOG_PATH="$repo_root/.wrangler/logs"
node -e 'if (process.versions.node.split(".")[0] !== "24") { console.error("Se requiere Node.js 24"); process.exit(1); }'
npm run build
npm run types
npm run typecheck
npm test
npx --no-install wrangler deploy --dry-run --config build/wrangler.json
echo "ST-043: verificaciones locales completas; no se ha desplegado."
